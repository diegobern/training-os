# Fake configuration for the local Firebase emulator suite.
# `demo-` projects never touch a real Firebase project and need no credentials.
# Nothing here is a secret; it exists so the automated tests can run offline.
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=demo-training-os.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-training-os
VITE_FIREBASE_STORAGE_BUCKET=demo-training-os.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_EMULATORS=1
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
