# ---------------------------------------------------------------------------
# TRAINING OS — environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in with your own Firebase web config.
# `.env` is git-ignored and must never be committed.
#
# A note on what is and is not secret: the Firebase *web* config below is a set
# of public identifiers. Every visitor's browser can see them, by design. They
# are not what protects your data — `firestore.rules` and `storage.rules` are.
# They live in environment variables so a build can be pointed at a different
# project without touching code.
#
# Nothing that IS secret (service-account keys, admin credentials, passwords)
# belongs in this project at all.
#
# Leave every value empty and Training OS runs in local mode: no accounts, no
# sync, everything stored on the device, exactly as it did before Firebase.
# Settings → Account will say FIREBASE NOT CONFIGURED and list what is missing.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Projects created from September 2024 onwards use PROJECT_ID.firebasestorage.app
# Older projects use PROJECT_ID.appspot.com — copy exactly what the console shows.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, only if you turn on Google Analytics for the web app.
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Local emulator suite — development and the automated tests only.
# Never set these in a production build.
# ---------------------------------------------------------------------------
# VITE_FIREBASE_EMULATORS=1
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
# VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
