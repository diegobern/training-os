rules_version = '2';

/*
 * TRAINING OS — Storage security rules
 *
 * Progress photos are private by definition. They live under the owner's uid
 * and nobody else can read them, list them or overwrite them.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSizeLimit() {
      return request.resource.size < 8 * 1024 * 1024;
    }

    match /users/{uid}/photos/{photoId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImage() && underSizeLimit();
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/avatar.jpg {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImage() && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
