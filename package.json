{
  "name": "training-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TRAINING OS - local-first training log, analytics and progressive-overload coach.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "test": "esbuild tests/unit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/unit.mjs --log-level=error && node node_modules/.cache/unit.mjs && node tests/catalog-integrity.mjs",
    "test:e2e": "node e2e/flow.mjs",
    "test:auth": "firebase emulators:exec --only auth --project demo-training-os \"node tests/firebase-auth.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-training-os \"node tests/firestore-rules.mjs\"",
    "test:account": "node e2e/account.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-training-os",
    "build:test": "tsc -b && vite build --mode test",
    "test:catalog": "node tests/catalog-integrity.mjs",
    "catalog:build": "node scripts/catalog/import.mjs",
    "test:onboarding": "node e2e/onboarding.mjs",
    "test:boot": "node e2e/boot-matrix.mjs",
    "test:sw": "node e2e/sw-offline.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.186.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.30.1",
    "playwright": "^1.47.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}