# Local-only build for the automated end-to-end suite.
#
# Every Firebase key is deliberately blank: with no configuration the app runs
# in its `local-only` phase, exactly as it does before anyone signs in and
# exactly as it must keep working offline. That is the honest way to exercise
# the catalog UI in a sandbox with no Firebase emulator, and it also covers the
# no-account path, which is a real path for a real user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
